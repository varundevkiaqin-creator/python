{
    "version": 1,
    "disable_existing_loggers": false,

    "formatters": {
        "standard": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },

    "filters": {
        "important_messages": {
            "()": "logging.Filter",
            "name": ""
        }
    },

    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "standard",
            "filters": []
        },

        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "standard",
            "filename": "logs/dict_application.log",
            "maxBytes": 1048576,
            "backupCount": 3,
            "encoding": "utf-8"
        }
    },

    "root": {
        "level": "DEBUG",
        "handlers": [
            "console",
            "file"
        ]
    }
}